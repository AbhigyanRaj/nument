# nument settings. Copy this file to .env and change what you need:
#
#   cp .env.example .env
#
# Every value shown is the default, so an untouched copy works as is.
# Without an API key for the chosen provider the app runs in mock mode
# (rule-based request parsing and template text), so it always starts.
#
# Keep comments on their own lines: Docker Compose reads "KEY=   # note"
# as the value "# note" when the value is blank.

# ---------------------------------------------------------------------------
# LLM (only reads the request and writes the words; never makes numbers)
# ---------------------------------------------------------------------------
# gemini | openai | anthropic | ollama
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.8-flash
# Key for the chosen provider. Leave blank to run in mock mode.
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Local models through Ollama (host.docker.internal works from inside Docker)
OLLAMA_BASE_URL=http://host.docker.internal:11434
# true = never call an LLM, even when a key is set
MOCK_LLM=false

# ---------------------------------------------------------------------------
# Data and planning
# ---------------------------------------------------------------------------
# SQLite file (relative to the project root); any SQLAlchemy URL works
DB_URL=sqlite:///data/allocation.db
# Optional ISO date, a Monday. Blank = the Monday on or before (earliest due - 7 days)
PLANNING_START=
# Goods made in week w ship on week start + this many days (4 = Friday)
SHIP_OFFSET_DAYS=4
# Used when a plant row has no energy price
DEFAULT_ENERGY_PRICE_PER_KWH=0.10
# cpsat (exact, with greedy fallback) | greedy
SOLVER=cpsat
SOLVER_TIME_LIMIT_S=10
API_URL=http://localhost:8000
# Load data/sample on first start when the database is empty
AUTOLOAD_SAMPLE=true

# ---------------------------------------------------------------------------
# Accounts and security (see README, "Configuration")
# ---------------------------------------------------------------------------
# true = the API needs a session cookie or "Authorization: Bearer <API_KEY>"
REQUIRE_AUTH=false
# Bearer token for scripts when REQUIRE_AUTH=true
API_KEY=
# false = only existing accounts can log in
ALLOW_SIGNUP=true
# Optional demo account created on startup (password: at least 10 characters)
DEMO_EMAIL=
DEMO_PASSWORD=
# Login sessions last this long (sliding)
SESSION_TTL_HOURS=168
# Set true when served over HTTPS
COOKIE_SECURE=false
MAX_UPLOAD_MB=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
# Planning requests solved at the same time; more get 503 + Retry-After
ANALYZE_MAX_CONCURRENCY=2
