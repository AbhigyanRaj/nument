# Copy to .env and fill in what you need. Every value shown is the default.
# Without an API key for the chosen provider the app runs in mock mode
# (rule-based request parsing and template text), so it always starts.

# LLM
LLM_PROVIDER=gemini          # gemini | openai | anthropic | ollama
LLM_MODEL=gemini-3.8-flash
GEMINI_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
OLLAMA_BASE_URL=http://host.docker.internal:11434
MOCK_LLM=false

# Data and planning
DB_URL=sqlite:///data/allocation.db
PLANNING_START=              # optional ISO date (a Monday). Blank = derive from data
SHIP_OFFSET_DAYS=4
DEFAULT_ENERGY_PRICE_PER_KWH=0.10
SOLVER=cpsat                 # cpsat | greedy
SOLVER_TIME_LIMIT_S=10
API_URL=http://localhost:8000
AUTOLOAD_SAMPLE=true         # load data/sample on first start when the DB is empty

# Accounts and security (see README, "Auth")
REQUIRE_AUTH=false           # true = the API needs a session cookie or "Authorization: Bearer" with API_KEY
API_KEY=                     # bearer token for scripts when REQUIRE_AUTH=true
ALLOW_SIGNUP=true
DEMO_EMAIL=                  # optional account created on startup
DEMO_PASSWORD=               # at least 10 characters
SESSION_TTL_HOURS=168
COOKIE_SECURE=false          # set true when served over HTTPS
MAX_UPLOAD_MB=5
RATE_LIMIT_LOGIN_PER_MINUTE=10
ANALYZE_MAX_CONCURRENCY=2
